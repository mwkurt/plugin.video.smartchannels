<?xml version="1.0" encoding="UTF-8"?>
<!--
    SmartChannels_Main.xml  —  Default / Fallback skin (1080i / 1920x1080)
    =========================================================================
    Two-pane layout:
      Left  (control 100) : Channel list  ~55% width
      Right (control 200) : Upcoming queue items  ~43% width

    Control IDs are fixed — side_panel.py references them by number.
      100  = channel list
      200  = upcoming panel list
      300  = "Upcoming" header label (right pane)
      301  = right-pane background group (shown/hidden as a unit)
-->
<window type="dialog" id="9700">
    <defaultcontrol always="true">100</defaultcontrol>
    <zorder>1</zorder>

    <controls>

        <!-- ── Full-screen dimmed background ─────────────────────────── -->
        <control type="image">
            <left>0</left><top>0</top>
            <width>1920</width><height>1080</height>
            <texture colordiffuse="CC000000">white.png</texture>
        </control>

        <!-- ── Header bar ────────────────────────────────────────────── -->
        <control type="image">
            <left>0</left><top>0</top>
            <width>1920</width><height>70</height>
            <texture colordiffuse="FF1A1A2E">white.png</texture>
        </control>
        <control type="label">
            <left>40</left><top>10</top>
            <width>900</width><height>50</height>
            <label>Smart TV Channels</label>
            <font>font37</font>
            <aligny>center</aligny>
            <textcolor>FFFFFFFF</textcolor>
            <align>left</align>
        </control>

        <!-- ── Left pane background ──────────────────────────────────── -->
        <control type="image">
            <left>0</left><top>70</top>
            <width>1056</width><height>862</height>
            <texture colordiffuse="E5111111">white.png</texture>
        </control>

        <!-- "Channels:" header label (control 302), text set by the add-on -->
        <control type="label" id="302">
            <left>28</left><top>84</top>
            <width>1000</width><height>40</height>
            <label></label>
            <font>font32_title</font>
            <textcolor>FFA8B8FF</textcolor>
            <aligny>center</aligny>
            <align>left</align>
        </control>

        <!-- Separator under header -->
        <control type="image">
            <left>0</left><top>128</top>
            <width>1056</width><height>2</height>
            <texture colordiffuse="FF333366">white.png</texture>
        </control>

        <!-- ── Left pane: Channel list (control 100) ─────────────────── -->
        <control type="list" id="100">
            <left>0</left><top>132</top>
            <width>1056</width><height>800</height>
            <itemlayout height="110">
                <!-- Channel icon -->
                <control type="image">
                    <left>28</left><top>13</top>
                    <width>84</width><height>84</height>
                    <texture fallback="DefaultVideoPlaylists.png">$INFO[ListItem.Icon]</texture>
                </control>
                <!-- Channel name -->
                <control type="label">
                    <left>128</left><top>6</top>
                    <width>810</width><height>56</height>
                    <label>$INFO[ListItem.Label]</label>
                    <font>font40_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <selectedcolor>FFFFFFFF</selectedcolor>
                    <align>left</align>
                    <aligny>center</aligny>
                </control>
                <!-- Queue depth subtitle -->
                <control type="label">
                    <left>128</left><top>62</top>
                    <width>810</width><height>36</height>
                    <label>$INFO[ListItem.Label2]</label>
                    <font>font27</font>
                    <textcolor>FFC0C0C0</textcolor>
                    <selectedcolor>FFC0C0C0</selectedcolor>
                    <align>left</align>
                </control>
                <!-- Focus highlight bar -->
                <control type="image">
                    <left>10</left><top>3</top>
                    <width>960</width><height>104</height>
                    <texture border="14" colordiffuse="3300AAFF">rounded.png</texture>
                    <visible>Control.HasFocus(100)+ListItem.IsSelected</visible>
                </control>
            </itemlayout>
            <focusedlayout height="110">
                <!-- Focus bar: solid bright blue, white text, light accent strip -->
                <control type="image">
                    <left>10</left><top>3</top>
                    <width>960</width><height>104</height>
                    <texture border="14" colordiffuse="FF0B6CE0">rounded.png</texture>
                </control>
                <control type="image">
                    <left>16</left><top>20</top>
                    <width>6</width><height>70</height>
                    <texture border="5" colordiffuse="FF9FD6FF">rounded_small.png</texture>
                </control>
                <control type="image">
                    <left>28</left><top>13</top>
                    <width>84</width><height>84</height>
                    <texture fallback="DefaultVideoPlaylists.png">$INFO[ListItem.Icon]</texture>
                </control>
                <control type="label">
                    <left>128</left><top>6</top>
                    <width>810</width><height>56</height>
                    <label>$INFO[ListItem.Label]</label>
                    <font>font40_title</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <align>left</align>
                    <aligny>center</aligny>
                </control>
                <control type="label">
                    <left>128</left><top>62</top>
                    <width>810</width><height>36</height>
                    <label>$INFO[ListItem.Label2]</label>
                    <font>font27</font>
                    <textcolor>FFE6F0FF</textcolor>
                    <align>left</align>
                </control>
            </focusedlayout>
            <onright>200</onright>
            <onleft>100</onleft>
        </control>

        <!-- ── Divider ───────────────────────────────────────────────── -->
        <control type="image">
            <left>1056</left><top>70</top>
            <width>2</width><height>862</height>
            <texture colordiffuse="FF333366">white.png</texture>
        </control>

        <!-- ── Right pane group (control 301) — shown when panel loaded ─ -->
        <control type="group" id="301">
            <left>1060</left><top>70</top>
            <width>860</width><height>862</height>
            <visible>true</visible>

            <!-- Right pane background -->
            <control type="image">
                <left>0</left><top>0</top>
                <width>860</width><height>862</height>
                <texture colordiffuse="E50D0D1A">white.png</texture>
            </control>

            <!-- "Upcoming" header label (control 300) -->
            <control type="label" id="300">
                <left>20</left><top>14</top>
                <width>820</width><height>40</height>
                <label>Upcoming</label>
                <font>font32_title</font>
                <textcolor>FFA8B8FF</textcolor>
                <aligny>center</aligny>
                <align>left</align>
            </control>

            <!-- Separator under header -->
            <control type="image">
                <left>0</left><top>58</top>
                <width>860</width><height>2</height>
                <texture colordiffuse="FF333366">white.png</texture>
            </control>

            <!-- Right pane: Upcoming items list (control 200) -->
            <control type="list" id="200">
                <left>0</left><top>62</top>
                <width>860</width><height>800</height>
                <itemlayout height="120">
                    <!-- Poster (portrait 2:3) -->
                    <control type="image">
                        <left>24</left><top>10</top>
                        <width>60</width><height>90</height>
                        <texture fallback="DefaultVideo.png">$INFO[ListItem.Art(thumb)]</texture>
                    </control>
                    <!-- Title line -->
                    <control type="label">
                        <left>96</left><top>12</top>
                        <width>750</width><height>46</height>
                        <label>$INFO[ListItem.Label]</label>
                        <font>font32</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <selectedcolor>FFFFFFFF</selectedcolor>
                        <align>left</align>
                        <aligny>center</aligny>
                    </control>
                    <!-- Subtitle line -->
                    <control type="label">
                        <left>96</left><top>64</top>
                        <width>750</width><height>36</height>
                        <label>$INFO[ListItem.Label2]</label>
                        <font>font27</font>
                        <textcolor>FFC0C0C0</textcolor>
                        <selectedcolor>FFC0C0C0</selectedcolor>
                        <align>left</align>
                    </control>
                </itemlayout>
                <focusedlayout height="120">
                    <control type="image">
                        <left>4</left><top>3</top>
                        <width>852</width><height>114</height>
                        <texture border="14" colordiffuse="FF0B6CE0">rounded.png</texture>
                    </control>
                    <control type="image">
                        <left>12</left><top>20</top>
                        <width>6</width><height>80</height>
                        <texture border="5" colordiffuse="FF9FD6FF">rounded_small.png</texture>
                    </control>
                    <control type="image">
                        <left>24</left><top>10</top>
                        <width>60</width><height>90</height>
                        <texture fallback="DefaultVideo.png">$INFO[ListItem.Art(thumb)]</texture>
                    </control>
                    <control type="label">
                        <left>96</left><top>12</top>
                        <width>750</width><height>46</height>
                        <label>$INFO[ListItem.Label]</label>
                        <font>font32</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <align>left</align>
                        <aligny>center</aligny>
                    </control>
                    <control type="label">
                        <left>96</left><top>64</top>
                        <width>750</width><height>36</height>
                        <label>$INFO[ListItem.Label2]</label>
                        <font>font27</font>
                        <textcolor>FFE6F0FF</textcolor>
                        <align>left</align>
                    </control>
                </focusedlayout>
                <onleft>100</onleft>
                <onright>200</onright>
            </control>

        </control><!-- end group 301 -->

        <!-- ── Footer hint bar ───────────────────────────────────────── -->
        <control type="image">
            <left>0</left><top>1048</top>
            <width>1920</width><height>32</height>
            <texture colordiffuse="CC1A1A2E">white.png</texture>
        </control>
        <control type="label">
            <left>40</left><top>1052</top>
            <width>1840</width><height>24</height>
            <label>[B]ENTER[/B] Play  |  [B]→[/B] Browse upcoming  |  [B]←[/B] Back to channels  |  [B]BACK[/B] Close</label>
            <font>font12</font>
            <textcolor>FFB8B8B8</textcolor>
            <align>left</align>
        </control>

    </controls>
</window>
