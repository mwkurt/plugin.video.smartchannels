<?xml version="1.0" encoding="UTF-8"?>
<!--
    SmartChannels_Main.xml  —  Default / Fallback skin (1080i / 1920x1080)
    =========================================================================
    Two-pane layout:
      Left  (control 100) : Channel list  ~55% width
      Right (control 200) : Upcoming queue items  ~43% width

    Control IDs are fixed — side_panel.py references them by number.
      100  = channel list
      200  = upcoming panel list
      300  = "Upcoming" header label (right pane)
      301  = right-pane background group (shown/hidden as a unit)
-->
<window type="dialog" id="9700">
    <defaultcontrol always="true">100</defaultcontrol>
    <zorder>1</zorder>

    <controls>

        <!-- ── Full-screen dimmed background ─────────────────────────── -->
        <control type="image">
            <left>0</left><top>0</top>
            <width>1920</width><height>1080</height>
            <texture colordiffuse="CC000000">black.png</texture>
        </control>

        <!-- ── Header bar ────────────────────────────────────────────── -->
        <control type="image">
            <left>0</left><top>0</top>
            <width>1920</width><height>70</height>
            <texture colordiffuse="FF1A1A2E">black.png</texture>
        </control>
        <control type="label">
            <left>40</left><top>15</top>
            <width>900</width><height>40</height>
            <label>Smart TV Channels</label>
            <font>font20</font>
            <textcolor>FFFFFFFF</textcolor>
            <align>left</align>
        </control>

        <!-- ── Left pane background ──────────────────────────────────── -->
        <control type="image">
            <left>0</left><top>70</top>
            <width>1056</width><height>862</height>
            <texture colordiffuse="E5111111">black.png</texture>
        </control>

        <!-- ── Left pane: Channel list (control 100) ─────────────────── -->
        <control type="list" id="100">
            <left>0</left><top>70</top>
            <width>1056</width><height>862</height>
            <itemlayout height="96">
                <!-- Channel icon -->
                <control type="image">
                    <left>16</left><top>12</top>
                    <width>72</width><height>72</height>
                    <texture fallback="DefaultVideoPlaylists.png">$INFO[ListItem.Icon]</texture>
                </control>
                <!-- Channel name -->
                <control type="label">
                    <left>104</left><top>10</top>
                    <width>880</width><height>40</height>
                    <label>$INFO[ListItem.Label]</label>
                    <font>font20</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <selectedcolor>FFFFF000</selectedcolor>
                    <align>left</align>
                    <aligny>center</aligny>
                </control>
                <!-- Queue depth subtitle -->
                <control type="label">
                    <left>104</left><top>56</top>
                    <width>880</width><height>24</height>
                    <label>$INFO[ListItem.Label2]</label>
                    <font>font13</font>
                    <textcolor>FFB0B0B0</textcolor>
                    <selectedcolor>FFDDDD00</selectedcolor>
                    <align>left</align>
                </control>
                <!-- Focus highlight bar -->
                <control type="image">
                    <left>0</left><top>0</top>
                    <width>1056</width><height>96</height>
                    <texture colordiffuse="3300AAFF">black.png</texture>
                    <visible>Control.HasFocus(100)+ListItem.IsSelected</visible>
                </control>
            </itemlayout>
            <focusedlayout height="96">
                <control type="image">
                    <left>0</left><top>0</top>
                    <width>1056</width><height>96</height>
                    <texture colordiffuse="550088FF">black.png</texture>
                </control>
                <control type="image">
                    <left>16</left><top>12</top>
                    <width>72</width><height>72</height>
                    <texture fallback="DefaultVideoPlaylists.png">$INFO[ListItem.Icon]</texture>
                </control>
                <control type="label">
                    <left>104</left><top>10</top>
                    <width>880</width><height>40</height>
                    <label>$INFO[ListItem.Label]</label>
                    <font>font20</font>
                    <textcolor>FFFFF000</textcolor>
                    <align>left</align>
                    <aligny>center</aligny>
                </control>
                <control type="label">
                    <left>104</left><top>56</top>
                    <width>880</width><height>24</height>
                    <label>$INFO[ListItem.Label2]</label>
                    <font>font13</font>
                    <textcolor>FFDDDD00</textcolor>
                    <align>left</align>
                </control>
            </focusedlayout>
            <onright>200</onright>
            <onleft>100</onleft>
        </control>

        <!-- ── Divider ───────────────────────────────────────────────── -->
        <control type="image">
            <left>1056</left><top>70</top>
            <width>2</width><height>862</height>
            <texture colordiffuse="FF333366">black.png</texture>
        </control>

        <!-- ── Right pane group (control 301) — shown when panel loaded ─ -->
        <control type="group" id="301">
            <left>1060</left><top>70</top>
            <width>860</width><height>862</height>
            <visible>true</visible>

            <!-- Right pane background -->
            <control type="image">
                <left>0</left><top>0</top>
                <width>860</width><height>862</height>
                <texture colordiffuse="E50D0D1A">black.png</texture>
            </control>

            <!-- "Upcoming" header label (control 300) -->
            <control type="label" id="300">
                <left>20</left><top>14</top>
                <width>820</width><height>40</height>
                <label>Upcoming</label>
                <font>font16</font>
                <textcolor>FF8888CC</textcolor>
                <align>left</align>
            </control>

            <!-- Separator under header -->
            <control type="image">
                <left>0</left><top>58</top>
                <width>860</width><height>2</height>
                <texture colordiffuse="FF333366">black.png</texture>
            </control>

            <!-- Right pane: Upcoming items list (control 200) -->
            <control type="list" id="200">
                <left>0</left><top>62</top>
                <width>860</width><height>800</height>
                <itemlayout height="120">
                    <!-- Poster (portrait 2:3) -->
                    <control type="image">
                        <left>12</left><top>10</top>
                        <width>60</width><height>90</height>
                        <texture fallback="DefaultVideo.png">$INFO[ListItem.Art(thumb)]</texture>
                    </control>
                    <!-- Title line -->
                    <control type="label">
                        <left>84</left><top>20</top>
                        <width>760</width><height>40</height>
                        <label>$INFO[ListItem.Label]</label>
                        <font>font20</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <selectedcolor>FFFFF000</selectedcolor>
                        <align>left</align>
                        <aligny>center</aligny>
                    </control>
                    <!-- Subtitle line -->
                    <control type="label">
                        <left>84</left><top>68</top>
                        <width>760</width><height>28</height>
                        <label>$INFO[ListItem.Label2]</label>
                        <font>font13</font>
                        <textcolor>FFB0B0B0</textcolor>
                        <selectedcolor>FFDDDD00</selectedcolor>
                        <align>left</align>
                    </control>
                </itemlayout>
                <focusedlayout height="120">
                    <control type="image">
                        <left>0</left><top>0</top>
                        <width>860</width><height>120</height>
                        <texture colordiffuse="550088FF">black.png</texture>
                    </control>
                    <control type="image">
                        <left>12</left><top>10</top>
                        <width>60</width><height>90</height>
                        <texture fallback="DefaultVideo.png">$INFO[ListItem.Art(thumb)]</texture>
                    </control>
                    <control type="label">
                        <left>84</left><top>20</top>
                        <width>760</width><height>40</height>
                        <label>$INFO[ListItem.Label]</label>
                        <font>font20</font>
                        <textcolor>FFFFF000</textcolor>
                        <align>left</align>
                        <aligny>center</aligny>
                    </control>
                    <control type="label">
                        <left>84</left><top>68</top>
                        <width>760</width><height>28</height>
                        <label>$INFO[ListItem.Label2]</label>
                        <font>font13</font>
                        <textcolor>FFDDDD00</textcolor>
                        <align>left</align>
                    </control>
                </focusedlayout>
                <onleft>100</onleft>
                <onright>200</onright>
            </control>

        </control><!-- end group 301 -->

        <!-- ── Footer hint bar ───────────────────────────────────────── -->
        <control type="image">
            <left>0</left><top>1048</top>
            <width>1920</width><height>32</height>
            <texture colordiffuse="CC1A1A2E">black.png</texture>
        </control>
        <control type="label">
            <left>40</left><top>1052</top>
            <width>1840</width><height>24</height>
            <label>[B]ENTER[/B] Play  |  [B]→[/B] Browse upcoming  |  [B]←[/B] Back to channels  |  [B]BACK[/B] Close</label>
            <font>font12</font>
            <textcolor>FF888888</textcolor>
            <align>left</align>
        </control>

    </controls>
</window>
